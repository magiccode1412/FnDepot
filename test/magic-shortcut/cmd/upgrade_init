#!/bin/bash

### This script is called before the application upgrade.

echo "正在准备升级快捷方式管理器..."

# 备份当前的 config 文件
CONFIG_FILE="${TRIM_APPDEST}/ui/config"
BACKUP_DIR="${TRIM_PKGMETA}/backup_$(date +%Y%m%d_%H%M%S)"

if [ -f "$CONFIG_FILE" ]; then
    mkdir -p "$BACKUP_DIR"
    cp "$CONFIG_FILE" "$BACKUP_DIR/"
    cp -r "${TRIM_APPDEST}/ui/images/icon_custom_"* "$BACKUP_DIR/" 2>/dev/null || true
    echo "已备份现有配置到: $BACKUP_DIR"
fi

# 备份数据文件
DATA_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/shortcuts.json"
if [ -f "$DATA_FILE" ]; then
    cp "$DATA_FILE" "$BACKUP_DIR/"
    echo "已备份数据文件"
fi

echo "升级前准备完成！"

exit 0
