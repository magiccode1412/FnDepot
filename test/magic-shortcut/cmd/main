#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
USER_LOG="${TRIM_TEMP_LOGFILE:-}"  # V1.1.8+: 错误信息展示给用户
PID_FILE="${TRIM_PKGVAR}/app.pid"
VENV_DIR="${TRIM_APPDEST}/server/venv"
SERVER_DIR="${TRIM_APPDEST}/server"
SERVER_PORT="${SERVER_PORT:-8090}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 用户可见日志（仅当 TRIM_TEMP_LOGFILE 可用时）
user_log() {
    [ -n "$USER_LOG" ] && echo "$1" >> "${USER_LOG}"
}

start_process() {
    if status; then
        log_msg "Process already running"
        return 0
    fi

    log_msg "=========================================="
    log_msg "Starting shortcut manager..."
    
    # 显示环境信息
    log_msg "TRIM_APPDEST: ${TRIM_APPDEST}"
    log_msg "TRIM_PKGVAR: ${TRIM_PKGVAR}"
    log_msg "SERVER_DIR: ${SERVER_DIR}"
    log_msg "VENV_DIR: ${VENV_DIR}"
    log_msg "SERVER_PORT: ${SERVER_PORT}"

    # 确保虚拟环境存在
    if [ ! -d "$VENV_DIR" ]; then
        log_msg "ERROR: Virtual environment not found at $VENV_DIR"
        user_log "ERROR: 虚拟环境不存在: $VENV_DIR，请重新安装应用"
        exit 1
    fi
    
    # 检查 Python 可用性
    if [ ! -x "$VENV_DIR/bin/python3" ]; then
        log_msg "ERROR: Python not found in virtual environment"
        user_log "ERROR: 虚拟环境中 Python 不可用，请重新安装应用"
        exit 1
    fi
    
    # 检查依赖是否安装（内联依赖列表，使用 python3 -m pip）
    if ! "$VENV_DIR/bin/python3" -c "import fastapi" 2>>${LOG_FILE}; then
        log_msg "ERROR: FastAPI not installed, installing dependencies..."
        for pkg in "fastapi==0.104.1" "uvicorn==0.30.1" "python-multipart==0.0.6" "Pillow==10.1.0" "pydantic==2.5.2"; do
            "$VENV_DIR/bin/python3" -m pip install -i "https://pypi.tuna.tsinghua.edu.cn/simple" --trusted-host "pypi.tuna.tsinghua.edu.cn" -q --no-cache-dir "${pkg}" >> ${LOG_FILE} 2>&1
        done
    fi

    # 设置环境变量（全部导出给子进程）
    export PYTHONPATH="${SERVER_DIR}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export TRIM_USERNAME="${TRIM_USERNAME:-root}"
    export TRIM_GROUPNAME="${TRIM_GROUPNAME:-root}"
    export SERVER_PORT="${SERVER_PORT}"

    cd "$SERVER_DIR"
    
    # 预检查：验证 main.py 存在
    if [ ! -f "${SERVER_DIR}/main.py" ]; then
        log_msg "ERROR: main.py not found at ${SERVER_DIR}/main.py"
        user_log "ERROR: 服务器文件不存在: ${SERVER_DIR}/main.py"
        exit 1
    fi
    
    # 预检查：快速测试 Python 能否导入模块
    IMPORT_TEST=$("$VENV_DIR/bin/python3" -c "
import sys
sys.path.insert(0, '${SERVER_DIR}')
try:
    import fastapi; print('fastapi OK')
except Exception as e: print(f'fastapi FAIL: {e}', file=sys.stderr); sys.exit(1)
try:
    import uvicorn; print('uvicorn OK')
except Exception as e: print(f'uvicorn FAIL: {e}', file=sys.stderr); sys.exit(1)
try:
    from PIL import Image; print('pillow OK')
except: print('pillow WARN (optional)')
print('ALL_IMPORT_OK')
    " 2>&1)
    
    log_msg "Import test: ${IMPORT_TEST}"
    
    if ! echo "$IMPORT_TEST" | grep -q "ALL_IMPORT_OK"; then
        log_msg "ERROR: Import test failed!"
        user_log "ERROR: Python 模块导入失败:"
        echo "$IMPORT_TEST" | while read line; do user_log "  $line"; done
        exit 1
    fi
    
    log_msg "Executing: $VENV_DIR/bin/python3 ${SERVER_DIR}/main.py (port ${SERVER_PORT})"
    
    nohup $VENV_DIR/bin/python3 "${SERVER_DIR}/main.py" \
        >> ${LOG_FILE} 2>&1 &
    
    local PID=$!
    printf "%s" "$PID" > ${PID_FILE}
    
    log_msg "Started with PID: $PID"
    
    # 等待 HTTP 端口就绪（最多5秒）
    local count=0
    while [ $count -lt 10 ]; do
        sleep 0.5
        count=$((count + 1))
        
        # 检查进程是否还在运行
        if ! kill -0 "$PID" 2>/dev/null; then
            log_msg "ERROR: Process died before port was ready!"
            user_log "ERROR: 进程启动后立即退出！"
            log_msg "Last 30 lines of output:"
            tail -30 ${LOG_FILE} | while read line; do
                log_msg "  $line"
            done
            user_log "--- 最近日志 ---"
            tail -15 ${LOG_FILE} | while read line; do
                user_log "  $line"
            done
            rm -f "${PID_FILE}"
            exit 1
        fi
        
        # 尝试连接端口
        if command -v curl &> /dev/null; then
            if curl -s -o /dev/null -m 1 "http://127.0.0.1:${SERVER_PORT}/" 2>/dev/null; then
                break
            fi
        elif command -v wget &> /dev/null; then
            if wget -q -O /dev/null -T 1 "http://127.0.0.1:${SERVER_PORT}/" 2>/dev/null; then
                break
            fi
        fi
    done

    # 验证进程仍在运行且端口可访问
    if kill -0 "$PID" 2>/dev/null; then
        log_msg "SUCCESS: Server is running on http://0.0.0.0:${SERVER_PORT}"
    else
        log_msg "ERROR: Server failed to start!"
        user_log "ERROR: 服务启动失败！"
        user_log "--- 最近日志 ---"
        tail -15 ${LOG_FILE} | while read line; do
            user_log "  $line"
        done
        rm -f "${PID_FILE}"
        exit 1
    fi

    log_msg "Shortcut manager started successfully!"
    return 0
}

stop_process() {
    log_msg "Stopping shortcut manager..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi

        log_msg "Sending TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done

        if check_process "${pid}"; then
            log_msg "Sending KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
        fi

        rm -f "${PID_FILE}"
    fi

    log_msg "Shortcut manager stopped."
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
