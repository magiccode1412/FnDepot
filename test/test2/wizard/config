[
    {
        "stepTitle": "端口设置",
        "items": [
            {
                "type": "tips",
                "helpText": "修改 Nginx 服务端口后，需要重启应用才能生效。"
            },
            {
                "type": "text",
                "field": "host_port",
                "label": "服务端口号",
                "initValue": "8080",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入端口号"
                    },
                    {
                        "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "端口号必须是1-65535之间的数字"
                    }
                ]
            },
            {
                "type": "tips",
                "helpText": "提示：请确保新端口未被其他应用占用。"
            }
        ]
    }
]